name: Build Android APK

on:
  push:
    branches: [main, master]
  workflow_dispatch:
    inputs:
      build_type:
        description: "Build type"
        default: "release"
        type: choice
        options: [release, debug]

permissions:
  contents: write

jobs:
  build:
    runs-on: ubuntu-latest
    timeout-minutes: 40
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Set up Java 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "17"

      - name: Set up Flutter
        uses: subosito/flutter-action@v2
        with:
          channel: stable
          cache: true

      - name: Generate Android platform files
        run: flutter create . --platforms android --project-name splitcircle --org com.splitcircle

      - name: Set app name
        run: sed -i 's/android:label="[^"]*"/android:label="SplitCircle"/' android/app/src/main/AndroidManifest.xml

      - name: Get packages
        run: flutter pub get

      # Tests are informational: a failing test will not block the APK.
      - name: Run tests
        continue-on-error: true
        run: flutter test

      - name: Build APK
        run: flutter build apk --${{ inputs.build_type || 'release' }}

      - name: Upload APK as artifact
        uses: actions/upload-artifact@v4
        with:
          name: splitcircle-apk
          path: build/app/outputs/flutter-apk/*.apk

      - name: Publish GitHub Release
        uses: softprops/action-gh-release@v2
        with:
          tag_name: v0.1.${{ github.run_number }}
          name: SplitCircle build ${{ github.run_number }}
          files: build/app/outputs/flutter-apk/*.apk
